# CineHall — environment template
#
# Copy this file to `.env` (which is git-ignored) and adjust the values.
#   cp .env.example .env
#
# Everything below is read by server/index.js and server/db.js at startup.

# PostgreSQL connection string.
# The Docker database documented in database/README.md listens on 55432,
# not 5432, because this host already runs PostgreSQL on 5432.
DATABASE_URL=postgresql://cinehall:cinehall@127.0.0.1:55432/cinehall

# Port the Express server (API + static frontend) listens on.
PORT=3000

# Secret used to sign HS256 JWTs. Replace with a long random string.
# Anyone who knows this can mint a token for any account.
JWT_SECRET=change-me-to-a-long-random-string